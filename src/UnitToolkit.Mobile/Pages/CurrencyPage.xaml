<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UnitToolkit.Presentation.ViewModels;assembly=UnitToolkit.Presentation"
             x:Class="UnitToolkit.Mobile.CurrencyPage"
             x:DataType="vm:CurrencyViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Currency Exchange">

    <ScrollView>
        <VerticalStackLayout Padding="0" Spacing="0">

            <!-- Header with Back Button -->
            <Frame BackgroundColor="{StaticResource AccentColor}"
                   CornerRadius="0"
                   Padding="20"
                   HasShadow="False"
                   Margin="0">
                <Grid>
                    <Button Text="← Back"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource PrimaryText}"
                            HorizontalOptions="Start"
                            Clicked="OnBackClicked" />
                    <Label Text="Currency Exchange"
                           Style="{StaticResource TitleLabel}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!-- Content Card -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">

                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                      IsVisible="{Binding IsLoading}"
                                      Color="{StaticResource AccentColor}" />

                    <Label Text="From Currency" Style="{StaticResource SubtitleLabel}" />
                    <Picker ItemsSource="{Binding AvailableCurrencies}"
                            SelectedItem="{Binding SelectedFromCurrency}"
                            Style="{StaticResource AppPicker}" />

                    <Label Text="Amount" Style="{StaticResource SubtitleLabel}" Margin="0,8,0,0" />
                    <Entry Text="{Binding Amount}"
                           Placeholder="Enter amount"
                           Keyboard="Numeric"
                           Style="{StaticResource AppEntry}" />

                    <Label Text="To Currency" Style="{StaticResource SubtitleLabel}" Margin="0,8,0,0" />
                    <Picker ItemsSource="{Binding AvailableCurrencies}"
                            SelectedItem="{Binding SelectedToCurrency}"
                            Style="{StaticResource AppPicker}" />

                    <Button Text="Convert"
                            Command="{Binding ConvertCommand}"
                            Style="{StaticResource AppButton}"
                            Margin="0,12,0,0" />

                    <Label Text="{Binding Result}"
                           Style="{StaticResource ResultLabel}"
                           IsVisible="{Binding Result, Converter={StaticResource StringNotEmptyConverter}}"
                           Margin="0,8,0,0" />

                    <Label Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorLabel}"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                           Margin="0,8,0,0" />

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
