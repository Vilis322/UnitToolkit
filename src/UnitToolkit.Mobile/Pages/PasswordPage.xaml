<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UnitToolkit.Presentation.ViewModels;assembly=UnitToolkit.Presentation"
             x:Class="UnitToolkit.Mobile.PasswordPage"
             x:DataType="vm:PasswordViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Password Generator">

    <ScrollView>
        <VerticalStackLayout Padding="0" Spacing="0">

            <!-- Header with Back Button -->
            <Frame BackgroundColor="{StaticResource AccentColor}"
                   CornerRadius="0"
                   Padding="20"
                   HasShadow="False"
                   Margin="0">
                <Grid>
                    <Button Text="← Back"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource PrimaryText}"
                            HorizontalOptions="Start"
                            Clicked="OnBackClicked" />
                    <Label Text="Password Generator"
                           Style="{StaticResource TitleLabel}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!-- Password Generator Card -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Password Generator"
                           Style="{StaticResource TitleLabel}"
                           FontSize="18" />

                    <Label Text="Password Length" Style="{StaticResource SubtitleLabel}" />
                    <Entry Text="{Binding PasswordLength}"
                           Placeholder="12"
                           Keyboard="Numeric"
                           Style="{StaticResource AppEntry}" />

                    <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                        <CheckBox IsChecked="{Binding UseUppercase}" />
                        <Label Text="Uppercase Letters"
                               TextColor="{StaticResource PrimaryText}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding UseDigits}" />
                        <Label Text="Numbers"
                               TextColor="{StaticResource PrimaryText}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding UseSymbols}" />
                        <Label Text="Symbols"
                               TextColor="{StaticResource PrimaryText}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Button Text="Generate Password"
                            Command="{Binding GeneratePasswordCommand}"
                            Style="{StaticResource AppButton}"
                            Margin="0,12,0,0" />

                    <Label Text="{Binding PasswordResult}"
                           Style="{StaticResource ResultLabel}"
                           IsVisible="{Binding PasswordResult, Converter={StaticResource StringNotEmptyConverter}}"
                           Margin="0,8,0,0" />

                    <Label Text="{Binding PasswordErrorMessage}"
                           Style="{StaticResource ErrorLabel}"
                           IsVisible="{Binding PasswordErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                           Margin="0,8,0,0" />

                </VerticalStackLayout>
            </Frame>

            <!-- Random Integer Card -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Random Integer Generator"
                           Style="{StaticResource TitleLabel}"
                           FontSize="18" />

                    <Label Text="Minimum Value" Style="{StaticResource SubtitleLabel}" />
                    <Entry Text="{Binding RandomMin}"
                           Placeholder="1"
                           Keyboard="Numeric"
                           Style="{StaticResource AppEntry}" />

                    <Label Text="Maximum Value" Style="{StaticResource SubtitleLabel}" Margin="0,8,0,0" />
                    <Entry Text="{Binding RandomMax}"
                           Placeholder="100"
                           Keyboard="Numeric"
                           Style="{StaticResource AppEntry}" />

                    <Button Text="Generate Random Integer"
                            Command="{Binding GenerateRandomIntCommand}"
                            Style="{StaticResource AppButton}"
                            Margin="0,12,0,0" />

                    <Label Text="{Binding RandomResult}"
                           Style="{StaticResource ResultLabel}"
                           IsVisible="{Binding RandomResult, Converter={StaticResource StringNotEmptyConverter}}"
                           Margin="0,8,0,0" />

                    <Label Text="{Binding RandomErrorMessage}"
                           Style="{StaticResource ErrorLabel}"
                           IsVisible="{Binding RandomErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                           Margin="0,8,0,0" />

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
