<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UnitToolkit.Desktop.Views.MainWindow"
        Width="760" Height="560" Title="Unit Toolkit">
  <TabControl>
    <!-- 1) Units -->
    <TabItem Header="Units">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" ColumnDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="12" VerticalAlignment="Center" Text="Type"/>
        <ComboBox x:Name="UnitTypeBox" Grid.Row="0" Grid.Column="1" Margin="12" SelectedIndex="0">
          <ComboBoxItem Content="Temperature"/>
          <ComboBoxItem Content="Length"/>
          <ComboBoxItem Content="Mass"/>
        </ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="12" VerticalAlignment="Center" Text="Value"/>
        <TextBox x:Name="UnitValueBox" Grid.Row="1" Grid.Column="1" Margin="12" Watermark="Use dot for decimals"/>

        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="12" Spacing="8">
          <ComboBox x:Name="FromUnitBox" Width="120"/>
          <TextBlock VerticalAlignment="Center" Text="→"/>
          <ComboBox x:Name="ToUnitBox" Width="120"/>
        </StackPanel>

        <Button Grid.Row="3" Grid.Column="1" Margin="12" Padding="12,6"
                HorizontalAlignment="Left" Click="OnUnitsConvertClick">Convert</Button>

        <TextBlock x:Name="UnitResultText" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                   Margin="12" FontSize="16" TextWrapping="Wrap"/>
      </Grid>
    </TabItem>

    <!-- 2) Currency -->
    <TabItem Header="Currency">
      <Grid RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="12" VerticalAlignment="Center" Text="Amount"/>
        <TextBox x:Name="CurAmountBox" Grid.Row="0" Grid.Column="1" Margin="12"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="12" VerticalAlignment="Center" Text="Rate (FROM→TO)"/>
        <TextBox x:Name="CurRateBox" Grid.Row="1" Grid.Column="1" Margin="12" Watermark="e.g., 1.1"/>

        <Button Grid.Row="2" Grid.Column="1" Margin="12" Padding="12,6"
                HorizontalAlignment="Left" Click="OnCurrencyConvertClick">Convert</Button>

        <TextBlock x:Name="CurResultText" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                   Margin="12" FontSize="16" TextWrapping="Wrap"/>
      </Grid>
    </TabItem>

    <!-- 3) Password / Random -->
    <TabItem Header="Password / Random">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="12" VerticalAlignment="Center" Text="Length"/>
        <TextBox x:Name="PwdLengthBox" Grid.Row="0" Grid.Column="1" Margin="12" Text="12"/>

        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="12" Spacing="16">
          <CheckBox x:Name="PwdUpperBox"   Content="Uppercase (A–Z)" IsChecked="True"/>
          <CheckBox x:Name="PwdDigitsBox"  Content="Digits (0–9)"    IsChecked="True"/>
          <CheckBox x:Name="PwdSymbolsBox" Content="Symbols (!@#…)"  IsChecked="False"/>
        </StackPanel>

        <Button Grid.Row="2" Grid.Column="1" Margin="12" Padding="12,6" HorizontalAlignment="Left"
                Click="OnGeneratePasswordClick">Generate Password</Button>

        <TextBlock x:Name="PwdResultText" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                   Margin="12" FontSize="16" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="12" Spacing="12">
          <TextBlock VerticalAlignment="Center" Text="Random int: Min"/>
          <TextBox x:Name="RandMinBox" Width="80"/>
          <TextBlock VerticalAlignment="Center" Text="Max"/>
          <TextBox x:Name="RandMaxBox" Width="80"/>
          <Button Padding="12,6" Click="OnRandomIntClick">Generate</Button>
        </StackPanel>

        <TextBlock x:Name="RandResultText" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                   Margin="12" FontSize="16" TextWrapping="Wrap"/>
      </Grid>
    </TabItem>

    <!-- 4) BMI -->
    <TabItem Header="BMI">
      <Grid RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="12" VerticalAlignment="Center" Text="Height (m or cm)"/>
        <TextBox x:Name="BmiHeightBox" Grid.Row="0" Grid.Column="1" Margin="12" Watermark="e.g., 1.70 or 170"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="12" VerticalAlignment="Center" Text="Weight (kg)"/>
        <TextBox x:Name="BmiWeightBox" Grid.Row="1" Grid.Column="1" Margin="12"/>

        <Button Grid.Row="2" Grid.Column="1" Margin="12" Padding="12,6" HorizontalAlignment="Left"
                Click="OnBmiCalculateClick">Calculate BMI</Button>

        <TextBlock x:Name="BmiResultText" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                   Margin="12" FontSize="16" TextWrapping="Wrap"/>
      </Grid>
    </TabItem>

    <!-- 5) Data Size -->
    <TabItem Header="Data Size">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" ColumnDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="12" VerticalAlignment="Center" Text="Value"/>
        <TextBox x:Name="DataValueBox" Grid.Row="0" Grid.Column="1" Margin="12" Watermark="e.g., 1536"/>

        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="12" Spacing="12">
          <TextBlock VerticalAlignment="Center" Text="From"/>
          <ComboBox x:Name="DataFromBox" Width="120"/>
          <TextBlock VerticalAlignment="Center" Text="To"/>
          <ComboBox x:Name="DataToBox" Width="120"/>
        </StackPanel>

        <Button Grid.Row="2" Grid.Column="1" Margin="12" Padding="12,6" HorizontalAlignment="Left"
                Click="OnDataSizeConvertClick">Convert</Button>

        <TextBlock x:Name="DataResultText" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                   Margin="12" FontSize="16" TextWrapping="Wrap"/>
      </Grid>
    </TabItem>
  </TabControl>
</Window>
