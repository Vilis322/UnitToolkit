<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UnitToolkit.Desktop.ViewModels"
        x:Class="UnitToolkit.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="800" Height="600" Title="Unit Toolkit">
  <Window.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#5B8DBE"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="16,8"/>
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#4A7CAD"/>
    </Style>
    <Style Selector="Border.section">
      <Setter Property="BorderBrush" Value="#E0E0E0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="12"/>
      <Setter Property="Background" Value="#FAFAFA"/>
    </Style>
  </Window.Styles>
  <TabControl Margin="8">
    <!-- 1) Units -->
    <TabItem Header="Units">
      <ScrollViewer>
        <Border Classes="section">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="Type" FontWeight="SemiBold"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Margin="8"
                      ItemsSource="{Binding ConversionTypes}"
                      SelectedItem="{Binding SelectedConversionType}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="Value" FontWeight="SemiBold"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="8" Watermark="Use dot for decimals"
                     Text="{Binding UnitValue}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="Convert" FontWeight="SemiBold"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="8" Spacing="8">
              <ComboBox Width="140"
                        ItemsSource="{Binding AvailableUnits}"
                        SelectedItem="{Binding SelectedFromUnit}"/>
              <TextBlock VerticalAlignment="Center" Text="→" FontSize="16"/>
              <ComboBox Width="140"
                        ItemsSource="{Binding AvailableUnits}"
                        SelectedItem="{Binding SelectedToUnit}"/>
            </StackPanel>

            <Button Grid.Row="3" Grid.Column="1" Margin="8"
                    Classes="primary"
                    HorizontalAlignment="Left" Command="{Binding ConvertUnitsCommand}">Convert</Button>

            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    Margin="8,16,8,8" Padding="12"
                    Background="#F5F5F5" CornerRadius="4"
                    BorderBrush="#DDDDDD" BorderThickness="1">
              <StackPanel>
                <TextBlock FontSize="16" TextWrapping="Wrap" Text="{Binding UnitResult}" FontWeight="Medium"/>
                <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="#D32F2F"
                           Text="{Binding UnitErrorMessage}"
                           IsVisible="{Binding UnitErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </ScrollViewer>
    </TabItem>

    <!-- 2) Currency -->
    <TabItem Header="Currency">
      <ScrollViewer>
        <Border Classes="section">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="Amount" FontWeight="SemiBold"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="8" Watermark="Enter amount"
                     Text="{Binding CurrencyAmount}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="From" FontWeight="SemiBold"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="8"
                      ItemsSource="{Binding AvailableCurrencies}"
                      SelectedItem="{Binding SelectedFromCurrency}"
                      IsEnabled="{Binding !IsLoadingCurrencies}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="To" FontWeight="SemiBold"/>
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="8"
                      ItemsSource="{Binding AvailableCurrencies}"
                      SelectedItem="{Binding SelectedToCurrency}"
                      IsEnabled="{Binding !IsLoadingCurrencies}"/>

            <Button Grid.Row="3" Grid.Column="1" Margin="8"
                    Classes="primary"
                    HorizontalAlignment="Left"
                    Command="{Binding ConvertCurrencyCommand}"
                    IsEnabled="{Binding !IsLoadingCurrencies}">Convert</Button>

            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    Margin="8,16,8,8" Padding="12"
                    Background="#F5F5F5" CornerRadius="4"
                    BorderBrush="#DDDDDD" BorderThickness="1">
              <StackPanel>
                <TextBlock FontSize="16" TextWrapping="Wrap" Text="{Binding CurrencyResult}" FontWeight="Medium"/>
                <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="#D32F2F"
                           Text="{Binding CurrencyErrorMessage}"
                           IsVisible="{Binding CurrencyErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
            </Border>

            <!-- Exchange Rates Table -->
            <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="8,16,8,8">
              <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"
                         Text="{Binding SelectedFromCurrency, StringFormat='Common Exchange Rates (Base: {0})'}"/>
              <DataGrid ItemsSource="{Binding CommonExchangeRates}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CanUserReorderColumns="False"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="False"
                        Height="250">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="*"/>
                  <DataGridTextColumn Header="Exchange Rate" Binding="{Binding Rate, StringFormat=N4}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Grid>
        </Border>
      </ScrollViewer>
    </TabItem>

    <!-- 3) Password / Random -->
    <TabItem Header="Password / Random">
      <ScrollViewer>
        <StackPanel>
          <!-- Password Section -->
          <Border Classes="section">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">
              <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                         Margin="0,0,0,12" FontSize="16" FontWeight="Bold" Text="Password Generator"/>

              <TextBlock Grid.Row="1" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="Length" FontWeight="SemiBold"/>
              <TextBox Grid.Row="1" Grid.Column="1" Margin="8" Width="200" HorizontalAlignment="Left"
                       Text="{Binding PasswordLength}"/>

              <TextBlock Grid.Row="2" Grid.Column="0" Margin="8" VerticalAlignment="Top" Text="Options" FontWeight="SemiBold"/>
              <StackPanel Grid.Row="2" Grid.Column="1" Margin="8" Spacing="8">
                <CheckBox Content="Uppercase (A–Z)" IsChecked="{Binding UseUppercase}"/>
                <CheckBox Content="Digits (0–9)" IsChecked="{Binding UseDigits}"/>
                <CheckBox Content="Symbols (!@#…)" IsChecked="{Binding UseSymbols}"/>
              </StackPanel>

              <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="8">
                <Button Classes="primary" HorizontalAlignment="Left"
                        Command="{Binding GeneratePasswordCommand}">Generate Password</Button>

                <Border Margin="0,12,0,0" Padding="12"
                        Background="#F5F5F5" CornerRadius="4"
                        BorderBrush="#DDDDDD" BorderThickness="1">
                  <StackPanel>
                    <TextBlock FontSize="16" TextWrapping="Wrap" Text="{Binding PasswordResult}" FontWeight="Medium"/>
                    <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="#D32F2F"
                               Text="{Binding PasswordErrorMessage}"
                               IsVisible="{Binding PasswordErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Random Integer Section -->
          <Border Classes="section">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">
              <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                         Margin="0,0,0,12" FontSize="16" FontWeight="Bold" Text="Random Integer"/>

              <TextBlock Grid.Row="1" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="Range" FontWeight="SemiBold"/>
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8" Spacing="8">
                <TextBox Width="100" Watermark="Min" Text="{Binding RandomMin}"/>
                <TextBlock VerticalAlignment="Center" Text="to" FontWeight="SemiBold"/>
                <TextBox Width="100" Watermark="Max" Text="{Binding RandomMax}"/>
              </StackPanel>

              <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="8">
                <Button Classes="primary" HorizontalAlignment="Left"
                        Command="{Binding GenerateRandomIntCommand}">Generate</Button>

                <Border Margin="0,12,0,0" Padding="12"
                        Background="#F5F5F5" CornerRadius="4"
                        BorderBrush="#DDDDDD" BorderThickness="1">
                  <StackPanel>
                    <TextBlock FontSize="16" TextWrapping="Wrap" Text="{Binding RandomResult}" FontWeight="Medium"/>
                    <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="#D32F2F"
                               Text="{Binding RandomErrorMessage}"
                               IsVisible="{Binding RandomErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- 4) BMI -->
    <TabItem Header="BMI">
      <ScrollViewer>
        <Border Classes="section">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="Height (m or cm)" FontWeight="SemiBold"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="8" Watermark="e.g., 1.70 or 170"
                     Text="{Binding BmiHeight}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="Weight (kg)" FontWeight="SemiBold"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="8"
                     Text="{Binding BmiWeight}"/>

            <Button Grid.Row="2" Grid.Column="1" Margin="8"
                    Classes="primary"
                    HorizontalAlignment="Left" Command="{Binding CalculateBmiCommand}">Calculate BMI</Button>

            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                    Margin="8,16,8,8" Padding="12"
                    Background="#F5F5F5" CornerRadius="4"
                    BorderBrush="#DDDDDD" BorderThickness="1">
              <StackPanel>
                <TextBlock FontSize="16" TextWrapping="Wrap" Text="{Binding BmiResult}" FontWeight="Medium"/>
                <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="#D32F2F"
                           Text="{Binding BmiErrorMessage}"
                           IsVisible="{Binding BmiErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </ScrollViewer>
    </TabItem>

    <!-- 5) Data Size -->
    <TabItem Header="Data Size">
      <ScrollViewer>
        <Border Classes="section">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" ColumnDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="Value" FontWeight="SemiBold"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="8" Watermark="e.g., 1536"
                     Text="{Binding DataValue}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="Convert" FontWeight="SemiBold"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8" Spacing="8">
              <ComboBox Width="140"
                        ItemsSource="{Binding DataSizeUnits}"
                        SelectedItem="{Binding SelectedDataFromUnit}"/>
              <TextBlock VerticalAlignment="Center" Text="→" FontSize="16"/>
              <ComboBox Width="140"
                        ItemsSource="{Binding DataSizeUnits}"
                        SelectedItem="{Binding SelectedDataToUnit}"/>
            </StackPanel>

            <Button Grid.Row="2" Grid.Column="1" Margin="8"
                    Classes="primary"
                    HorizontalAlignment="Left" Command="{Binding ConvertDataSizeCommand}">Convert</Button>

            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                    Margin="8,16,8,8" Padding="12"
                    Background="#F5F5F5" CornerRadius="4"
                    BorderBrush="#DDDDDD" BorderThickness="1">
              <StackPanel>
                <TextBlock FontSize="16" TextWrapping="Wrap" Text="{Binding DataResult}" FontWeight="Medium"/>
                <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="#D32F2F"
                           Text="{Binding DataErrorMessage}"
                           IsVisible="{Binding DataErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
