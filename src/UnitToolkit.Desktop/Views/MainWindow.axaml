<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UnitToolkit.Desktop.ViewModels"
        x:Class="UnitToolkit.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="800" Height="600" Title="Unit Toolkit">
  <Window.Styles>
    <!-- Button styles with proper hover states -->
    <Style Selector="Button">
      <Setter Property="Background" Value="#E0E0E0"/>
      <Setter Property="Foreground" Value="Black"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#CCCCCC"/>
      <Setter Property="Foreground" Value="Black"/>
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="#B0B0B0"/>
      <Setter Property="Foreground" Value="Black"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#5B8DBE"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#4A7CAD"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.primary:pressed">
      <Setter Property="Background" Value="#3A6C9D"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Border.section">
      <Setter Property="BorderBrush" Value="#E0E0E0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="12"/>
      <Setter Property="Background" Value="#FAFAFA"/>
    </Style>

    <!-- Text controls -->
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="Black"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Foreground" Value="Black"/>
      <Setter Property="Background" Value="White"/>
    </Style>

    <!-- CheckBox with proper foreground -->
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="Black"/>
    </Style>
    <Style Selector="CheckBox:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="Black"/>
    </Style>
    <Style Selector="CheckBox:checked /template/ ContentPresenter">
      <Setter Property="Foreground" Value="Black"/>
    </Style>

    <!-- ComboBox popup with light background -->
    <Style Selector="ComboBox">
      <Setter Property="Foreground" Value="Black"/>
      <Setter Property="Background" Value="White"/>
    </Style>
    <Style Selector="ComboBox /template/ Border#PART_PopupBorder">
      <Setter Property="Background" Value="White"/>
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="Black"/>
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E3F2FD"/>
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#BBDEFB"/>
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="Auto,*">
    <!-- Side Menu -->
    <Border Grid.Column="0"
            Background="#F5F5F5"
            BorderBrush="#E0E0E0"
            BorderThickness="0,0,1,0"
            Padding="12"
            IsVisible="{Binding !IsMenuView}">
      <Button Command="{Binding NavigateToMenuCommand}"
              Classes="primary"
              Margin="0,8,0,0">
        ← Back to Menu
      </Button>
    </Border>

    <!-- Main Content Area -->
    <ScrollViewer Grid.Column="1">
      <StackPanel>

        <!-- Main Menu Panel -->
        <StackPanel IsVisible="{Binding IsMenuView}" Margin="40">
          <TextBlock Text="Unit Toolkit"
                     FontSize="28"
                     FontWeight="Bold"
                     HorizontalAlignment="Center"
                     Margin="0,20,0,40"/>

          <StackPanel Spacing="16" MaxWidth="400" HorizontalAlignment="Center">
            <Button Command="{Binding NavigateToMeasurementsCommand}"
                    Classes="primary"
                    FontSize="16"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="20,12">
              Measurements Converter
            </Button>

            <Button Command="{Binding NavigateToCurrencyCommand}"
                    Classes="primary"
                    FontSize="16"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="20,12">
              Currency Converter
            </Button>

            <Button Command="{Binding NavigateToPasswordCommand}"
                    Classes="primary"
                    FontSize="16"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="20,12">
              Password &amp; Random Generator
            </Button>

            <Button Command="{Binding NavigateToBmiCommand}"
                    Classes="primary"
                    FontSize="16"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="20,12">
              BMI Calculator
            </Button>

            <Button Command="{Binding NavigateToDataSizeCommand}"
                    Classes="primary"
                    FontSize="16"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="20,12">
              Data Size Converter
            </Button>
          </StackPanel>
        </StackPanel>

        <!-- 1) Measurements Converter Panel -->
        <StackPanel IsVisible="{Binding IsMeasurementsView}">
        <Border Classes="section">
          <StackPanel>
            <!-- Help Button -->
            <Button Command="{Binding ToggleMeasurementsHelpCommand}"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,12">
              Help
            </Button>

            <!-- Help Content -->
            <Border IsVisible="{Binding IsMeasurementsHelpVisible}"
                    Background="#E3F2FD"
                    BorderBrush="#2196F3"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16"
                    Margin="0,0,0,16">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="Bold" FontSize="16" Text="Measurements Converter"/>
                <TextBlock FontWeight="SemiBold" Text="Features:"/>
                <TextBlock Text="• Convert between Temperature units (Celsius, Fahrenheit, Kelvin)" TextWrapping="Wrap"/>
                <TextBlock Text="• Convert between Length units (meters, centimeters, kilometers)" TextWrapping="Wrap"/>
                <TextBlock Text="• Convert between Mass units (kilograms, grams, pounds)" TextWrapping="Wrap"/>
                <TextBlock FontWeight="SemiBold" Text="Usage:" Margin="0,8,0,0"/>
                <TextBlock Text="1. Select the conversion type (Temperature, Length, or Mass)" TextWrapping="Wrap"/>
                <TextBlock Text="2. Enter the value you want to convert" TextWrapping="Wrap"/>
                <TextBlock Text="3. Select the unit you're converting from and the unit you're converting to" TextWrapping="Wrap"/>
                <TextBlock Text="4. Click Convert to see the result" TextWrapping="Wrap"/>
                <TextBlock Text="Note: Use dot (.) for decimal values, not comma" TextWrapping="Wrap" FontStyle="Italic"/>
              </StackPanel>
            </Border>

          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="Type" FontWeight="SemiBold"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Margin="8"
                      ItemsSource="{Binding ConversionTypes}"
                      SelectedItem="{Binding SelectedConversionType}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="Value" FontWeight="SemiBold"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="8" Watermark="Use dot for decimals"
                     Text="{Binding UnitValue}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="Convert" FontWeight="SemiBold"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="8" Spacing="8">
              <ComboBox Width="140"
                        ItemsSource="{Binding AvailableUnits}"
                        SelectedItem="{Binding SelectedFromUnit}"/>
              <TextBlock VerticalAlignment="Center" Text="→" FontSize="16"/>
              <ComboBox Width="140"
                        ItemsSource="{Binding AvailableUnits}"
                        SelectedItem="{Binding SelectedToUnit}"/>
            </StackPanel>

            <Button Grid.Row="3" Grid.Column="1" Margin="8"
                    Classes="primary"
                    HorizontalAlignment="Left" Command="{Binding ConvertUnitsCommand}">Convert</Button>

            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    Margin="8,16,8,8" Padding="12"
                    Background="#F5F5F5" CornerRadius="4"
                    BorderBrush="#DDDDDD" BorderThickness="1">
              <StackPanel>
                <TextBlock FontSize="16" TextWrapping="Wrap" Text="{Binding UnitResult}" FontWeight="Medium"/>
                <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="#D32F2F"
                           Text="{Binding UnitErrorMessage}"
                           IsVisible="{Binding UnitErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
            </Border>
          </Grid>
          </StackPanel>
        </Border>
        </StackPanel>

        <!-- 2) Currency Panel -->
        <StackPanel IsVisible="{Binding IsCurrencyView}">
        <Border Classes="section">
          <StackPanel>
            <!-- Help Button -->
            <Button Command="{Binding ToggleCurrencyHelpCommand}"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,12">
              Help
            </Button>

            <!-- Help Content -->
            <Border IsVisible="{Binding IsCurrencyHelpVisible}"
                    Background="#E3F2FD"
                    BorderBrush="#2196F3"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16"
                    Margin="0,0,0,16">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="Bold" FontSize="16" Text="Currency Converter"/>
                <TextBlock FontWeight="SemiBold" Text="Features:"/>
                <TextBlock Text="• Convert between multiple currencies using real-time exchange rates" TextWrapping="Wrap"/>
                <TextBlock Text="• View common exchange rates table for quick reference" TextWrapping="Wrap"/>
                <TextBlock Text="• Automatically fetches latest rates from Frankfurter API" TextWrapping="Wrap"/>
                <TextBlock FontWeight="SemiBold" Text="Usage:" Margin="0,8,0,0"/>
                <TextBlock Text="1. Enter the amount you want to convert" TextWrapping="Wrap"/>
                <TextBlock Text="2. Select the currency you're converting from (e.g., USD)" TextWrapping="Wrap"/>
                <TextBlock Text="3. Select the currency you're converting to (e.g., EUR)" TextWrapping="Wrap"/>
                <TextBlock Text="4. Click Convert to fetch the latest exchange rate and calculate the result" TextWrapping="Wrap"/>
                <TextBlock Text="Note: Requires internet connection to fetch exchange rates" TextWrapping="Wrap" FontStyle="Italic"/>
              </StackPanel>
            </Border>

          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="Amount" FontWeight="SemiBold"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="8" Watermark="Enter amount"
                     Text="{Binding CurrencyAmount}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="From" FontWeight="SemiBold"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="8"
                      ItemsSource="{Binding AvailableCurrencies}"
                      SelectedItem="{Binding SelectedFromCurrency}"
                      IsEnabled="{Binding !IsLoadingCurrencies}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="To" FontWeight="SemiBold"/>
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="8"
                      ItemsSource="{Binding AvailableCurrencies}"
                      SelectedItem="{Binding SelectedToCurrency}"
                      IsEnabled="{Binding !IsLoadingCurrencies}"/>

            <Button Grid.Row="3" Grid.Column="1" Margin="8"
                    Classes="primary"
                    HorizontalAlignment="Left"
                    Command="{Binding ConvertCurrencyCommand}"
                    IsEnabled="{Binding !IsLoadingCurrencies}">Convert</Button>

            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    Margin="8,16,8,8" Padding="12"
                    Background="#F5F5F5" CornerRadius="4"
                    BorderBrush="#DDDDDD" BorderThickness="1">
              <StackPanel>
                <TextBlock FontSize="16" TextWrapping="Wrap" Text="{Binding CurrencyResult}" FontWeight="Medium"/>
                <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="#D32F2F"
                           Text="{Binding CurrencyErrorMessage}"
                           IsVisible="{Binding CurrencyErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
            </Border>

            <!-- Exchange Rates Table -->
            <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="8,16,8,8">
              <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"
                         Text="{Binding SelectedFromCurrency, StringFormat='Common Exchange Rates (Base: {0})'}"/>
              <DataGrid ItemsSource="{Binding CommonExchangeRates}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CanUserReorderColumns="False"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="False"
                        Height="250">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="*"/>
                  <DataGridTextColumn Header="Exchange Rate" Binding="{Binding Rate, StringFormat=N4}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Grid>
          </StackPanel>
        </Border>
        </StackPanel>

        <!-- 3) Password / Random Panel -->
        <StackPanel IsVisible="{Binding IsPasswordView}">
          <!-- Help Section -->
          <Border Classes="section">
            <StackPanel>
              <!-- Help Button -->
              <Button Command="{Binding TogglePasswordHelpCommand}"
                      HorizontalAlignment="Right"
                      Margin="0,0,0,12">
                Help
              </Button>

              <!-- Help Content -->
              <Border IsVisible="{Binding IsPasswordHelpVisible}"
                      Background="#E3F2FD"
                      BorderBrush="#2196F3"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="16"
                      Margin="0,0,0,0">
                <StackPanel Spacing="8">
                  <TextBlock FontWeight="Bold" FontSize="16" Text="Password &amp; Random Generator"/>
                  <TextBlock FontWeight="SemiBold" Text="Password Generator Features:"/>
                  <TextBlock Text="• Generate secure random passwords with customizable options" TextWrapping="Wrap"/>
                  <TextBlock Text="• Choose password length (4-256 characters)" TextWrapping="Wrap"/>
                  <TextBlock Text="• Include uppercase letters, digits, and symbols" TextWrapping="Wrap"/>
                  <TextBlock FontWeight="SemiBold" Text="Password Generator Usage:" Margin="0,8,0,0"/>
                  <TextBlock Text="1. Enter desired password length (minimum 4, maximum 256)" TextWrapping="Wrap"/>
                  <TextBlock Text="2. Check options for uppercase letters, digits, and symbols as needed" TextWrapping="Wrap"/>
                  <TextBlock Text="3. Click Generate Password to create a random password" TextWrapping="Wrap"/>
                  <TextBlock FontWeight="SemiBold" Text="Random Integer Features:" Margin="0,8,0,0"/>
                  <TextBlock Text="• Generate random integers within a specified range" TextWrapping="Wrap"/>
                  <TextBlock FontWeight="SemiBold" Text="Random Integer Usage:"/>
                  <TextBlock Text="1. Enter minimum value" TextWrapping="Wrap"/>
                  <TextBlock Text="2. Enter maximum value" TextWrapping="Wrap"/>
                  <TextBlock Text="3. Click Generate to get a random integer in that range" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Password Section -->
          <Border Classes="section">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">
              <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                         Margin="0,0,0,12" FontSize="16" FontWeight="Bold" Text="Password Generator"/>

              <TextBlock Grid.Row="1" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="Length" FontWeight="SemiBold"/>
              <TextBox Grid.Row="1" Grid.Column="1" Margin="8" Width="200" HorizontalAlignment="Left"
                       Text="{Binding PasswordLength}"/>

              <TextBlock Grid.Row="2" Grid.Column="0" Margin="8" VerticalAlignment="Top" Text="Options" FontWeight="SemiBold"/>
              <StackPanel Grid.Row="2" Grid.Column="1" Margin="8" Spacing="8">
                <CheckBox Content="Uppercase (A–Z)" IsChecked="{Binding UseUppercase}"/>
                <CheckBox Content="Digits (0–9)" IsChecked="{Binding UseDigits}"/>
                <CheckBox Content="Symbols (!@#…)" IsChecked="{Binding UseSymbols}"/>
              </StackPanel>

              <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="8">
                <Button Classes="primary" HorizontalAlignment="Left"
                        Command="{Binding GeneratePasswordCommand}">Generate Password</Button>

                <Border Margin="0,12,0,0" Padding="12"
                        Background="#F5F5F5" CornerRadius="4"
                        BorderBrush="#DDDDDD" BorderThickness="1">
                  <StackPanel>
                    <TextBlock FontSize="16" TextWrapping="Wrap" Text="{Binding PasswordResult}" FontWeight="Medium"/>
                    <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="#D32F2F"
                               Text="{Binding PasswordErrorMessage}"
                               IsVisible="{Binding PasswordErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Random Integer Section -->
          <Border Classes="section">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">
              <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                         Margin="0,0,0,12" FontSize="16" FontWeight="Bold" Text="Random Integer"/>

              <TextBlock Grid.Row="1" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="Range" FontWeight="SemiBold"/>
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8" Spacing="8">
                <TextBox Width="100" Watermark="Min" Text="{Binding RandomMin}"/>
                <TextBlock VerticalAlignment="Center" Text="to" FontWeight="SemiBold"/>
                <TextBox Width="100" Watermark="Max" Text="{Binding RandomMax}"/>
              </StackPanel>

              <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="8">
                <Button Classes="primary" HorizontalAlignment="Left"
                        Command="{Binding GenerateRandomIntCommand}">Generate</Button>

                <Border Margin="0,12,0,0" Padding="12"
                        Background="#F5F5F5" CornerRadius="4"
                        BorderBrush="#DDDDDD" BorderThickness="1">
                  <StackPanel>
                    <TextBlock FontSize="16" TextWrapping="Wrap" Text="{Binding RandomResult}" FontWeight="Medium"/>
                    <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="#D32F2F"
                               Text="{Binding RandomErrorMessage}"
                               IsVisible="{Binding RandomErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <!-- 4) BMI Panel -->
        <StackPanel IsVisible="{Binding IsBmiView}">
        <Border Classes="section">
          <StackPanel>
            <!-- Help Button -->
            <Button Command="{Binding ToggleBmiHelpCommand}"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,12">
              Help
            </Button>

            <!-- Help Content -->
            <Border IsVisible="{Binding IsBmiHelpVisible}"
                    Background="#E3F2FD"
                    BorderBrush="#2196F3"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16"
                    Margin="0,0,0,16">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="Bold" FontSize="16" Text="BMI Calculator"/>
                <TextBlock FontWeight="SemiBold" Text="Features:"/>
                <TextBlock Text="• Calculate Body Mass Index based on height and weight" TextWrapping="Wrap"/>
                <TextBlock Text="• Automatically categorizes BMI (Underweight, Normal, Overweight, Obese)" TextWrapping="Wrap"/>
                <TextBlock Text="• Provides health advice based on BMI category" TextWrapping="Wrap"/>
                <TextBlock FontWeight="SemiBold" Text="Usage:" Margin="0,8,0,0"/>
                <TextBlock Text="1. Enter height in meters (e.g., 1.70) or centimeters (e.g., 170)" TextWrapping="Wrap"/>
                <TextBlock Text="2. Enter weight in kilograms (e.g., 70)" TextWrapping="Wrap"/>
                <TextBlock Text="3. Click Calculate BMI to see your BMI value, category, and health advice" TextWrapping="Wrap"/>
                <TextBlock Text="Note: BMI categories - Underweight: &lt;18.5, Normal: 18.5-24.9, Overweight: 25-29.9, Obese: ≥30" TextWrapping="Wrap" FontStyle="Italic"/>
              </StackPanel>
            </Border>

          <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="Height (m or cm)" FontWeight="SemiBold"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="8" Watermark="e.g., 1.70 or 170"
                     Text="{Binding BmiHeight}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="Weight (kg)" FontWeight="SemiBold"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="8"
                     Text="{Binding BmiWeight}"/>

            <Button Grid.Row="2" Grid.Column="1" Margin="8"
                    Classes="primary"
                    HorizontalAlignment="Left" Command="{Binding CalculateBmiCommand}">Calculate BMI</Button>

            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                    Margin="8,16,8,8" Padding="12"
                    Background="#F5F5F5" CornerRadius="4"
                    BorderBrush="#DDDDDD" BorderThickness="1">
              <StackPanel>
                <TextBlock FontSize="16" TextWrapping="Wrap" Text="{Binding BmiResult}" FontWeight="Medium"/>
                <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="#D32F2F"
                           Text="{Binding BmiErrorMessage}"
                           IsVisible="{Binding BmiErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
            </Border>
          </Grid>
          </StackPanel>
        </Border>
        </StackPanel>

        <!-- 5) Data Size Panel -->
        <StackPanel IsVisible="{Binding IsDataSizeView}">
        <Border Classes="section">
          <StackPanel>
            <!-- Help Button -->
            <Button Command="{Binding ToggleDataSizeHelpCommand}"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,12">
              Help
            </Button>

            <!-- Help Content -->
            <Border IsVisible="{Binding IsDataSizeHelpVisible}"
                    Background="#E3F2FD"
                    BorderBrush="#2196F3"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16"
                    Margin="0,0,0,16">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="Bold" FontSize="16" Text="Data Size Converter"/>
                <TextBlock FontWeight="SemiBold" Text="Features:"/>
                <TextBlock Text="• Convert between data size units (bytes, KB, MB, GB, TB)" TextWrapping="Wrap"/>
                <TextBlock Text="• Supports both decimal (KB, MB, GB, TB) and binary (KiB, MiB, GiB, TiB) units" TextWrapping="Wrap"/>
                <TextBlock Text="• Accurate conversions using proper factors (1000 for decimal, 1024 for binary)" TextWrapping="Wrap"/>
                <TextBlock FontWeight="SemiBold" Text="Usage:" Margin="0,8,0,0"/>
                <TextBlock Text="1. Enter the data size value you want to convert" TextWrapping="Wrap"/>
                <TextBlock Text="2. Select the unit you're converting from (e.g., MB)" TextWrapping="Wrap"/>
                <TextBlock Text="3. Select the unit you're converting to (e.g., GB)" TextWrapping="Wrap"/>
                <TextBlock Text="4. Click Convert to see the result" TextWrapping="Wrap"/>
                <TextBlock Text="Note: Decimal units (KB, MB, GB) use base 1000, binary units (KiB, MiB, GiB) use base 1024" TextWrapping="Wrap" FontStyle="Italic"/>
              </StackPanel>
            </Border>

          <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" ColumnDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="Value" FontWeight="SemiBold"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="8" Watermark="e.g., 1536"
                     Text="{Binding DataValue}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="8" VerticalAlignment="Center" Text="Convert" FontWeight="SemiBold"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8" Spacing="8">
              <ComboBox Width="140"
                        ItemsSource="{Binding DataSizeUnits}"
                        SelectedItem="{Binding SelectedDataFromUnit}"/>
              <TextBlock VerticalAlignment="Center" Text="→" FontSize="16"/>
              <ComboBox Width="140"
                        ItemsSource="{Binding DataSizeUnits}"
                        SelectedItem="{Binding SelectedDataToUnit}"/>
            </StackPanel>

            <Button Grid.Row="2" Grid.Column="1" Margin="8"
                    Classes="primary"
                    HorizontalAlignment="Left" Command="{Binding ConvertDataSizeCommand}">Convert</Button>

            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                    Margin="8,16,8,8" Padding="12"
                    Background="#F5F5F5" CornerRadius="4"
                    BorderBrush="#DDDDDD" BorderThickness="1">
              <StackPanel>
                <TextBlock FontSize="16" TextWrapping="Wrap" Text="{Binding DataResult}" FontWeight="Medium"/>
                <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="#D32F2F"
                           Text="{Binding DataErrorMessage}"
                           IsVisible="{Binding DataErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
            </Border>
          </Grid>
          </StackPanel>
        </Border>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
