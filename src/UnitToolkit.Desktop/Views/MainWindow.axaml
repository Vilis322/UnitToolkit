<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UnitToolkit.Desktop.ViewModels"
        x:Class="UnitToolkit.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="760" Height="560" Title="Unit Toolkit">
  <TabControl>
    <!-- 1) Units -->
    <TabItem Header="Units">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" ColumnDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="12" VerticalAlignment="Center" Text="Type"/>
        <ComboBox Grid.Row="0" Grid.Column="1" Margin="12"
                  ItemsSource="{Binding ConversionTypes}"
                  SelectedItem="{Binding SelectedConversionType}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="12" VerticalAlignment="Center" Text="Value"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="12" Watermark="Use dot for decimals"
                 Text="{Binding UnitValue}"/>

        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="12" Spacing="8">
          <ComboBox Width="120"
                    ItemsSource="{Binding AvailableUnits}"
                    SelectedItem="{Binding SelectedFromUnit}"/>
          <TextBlock VerticalAlignment="Center" Text="→"/>
          <ComboBox Width="120"
                    ItemsSource="{Binding AvailableUnits}"
                    SelectedItem="{Binding SelectedToUnit}"/>
        </StackPanel>

        <Button Grid.Row="3" Grid.Column="1" Margin="12" Padding="12,6"
                HorizontalAlignment="Left" Command="{Binding ConvertUnitsCommand}">Convert</Button>

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="12">
          <TextBlock FontSize="16" TextWrapping="Wrap" Text="{Binding UnitResult}"/>
          <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="Red"
                     Text="{Binding UnitErrorMessage}"
                     IsVisible="{Binding UnitErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </Grid>
    </TabItem>

    <!-- 2) Currency -->
    <TabItem Header="Currency">
      <Grid RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="12" VerticalAlignment="Center" Text="Amount"/>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="12"
                 Text="{Binding CurrencyAmount}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="12" VerticalAlignment="Center" Text="Rate (FROM→TO)"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="12" Watermark="e.g., 1.1"
                 Text="{Binding CurrencyRate}"/>

        <Button Grid.Row="2" Grid.Column="1" Margin="12" Padding="12,6"
                HorizontalAlignment="Left" Command="{Binding ConvertCurrencyCommand}">Convert</Button>

        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="12">
          <TextBlock FontSize="16" TextWrapping="Wrap" Text="{Binding CurrencyResult}"/>
          <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="Red"
                     Text="{Binding CurrencyErrorMessage}"
                     IsVisible="{Binding CurrencyErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </Grid>
    </TabItem>

    <!-- 3) Password / Random -->
    <TabItem Header="Password / Random">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="12" VerticalAlignment="Center" Text="Length"/>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="12"
                 Text="{Binding PasswordLength}"/>

        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="12" Spacing="16">
          <CheckBox Content="Uppercase (A–Z)" IsChecked="{Binding UseUppercase}"/>
          <CheckBox Content="Digits (0–9)" IsChecked="{Binding UseDigits}"/>
          <CheckBox Content="Symbols (!@#…)" IsChecked="{Binding UseSymbols}"/>
        </StackPanel>

        <Button Grid.Row="2" Grid.Column="1" Margin="12" Padding="12,6" HorizontalAlignment="Left"
                Command="{Binding GeneratePasswordCommand}">Generate Password</Button>

        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="12">
          <TextBlock FontSize="16" TextWrapping="Wrap" Text="{Binding PasswordResult}"/>
          <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="Red"
                     Text="{Binding PasswordErrorMessage}"
                     IsVisible="{Binding PasswordErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="12" Spacing="12">
          <TextBlock VerticalAlignment="Center" Text="Random int: Min"/>
          <TextBox Width="80" Text="{Binding RandomMin}"/>
          <TextBlock VerticalAlignment="Center" Text="Max"/>
          <TextBox Width="80" Text="{Binding RandomMax}"/>
          <Button Padding="12,6" Command="{Binding GenerateRandomIntCommand}">Generate</Button>
        </StackPanel>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="12">
          <TextBlock FontSize="16" TextWrapping="Wrap" Text="{Binding RandomResult}"/>
          <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="Red"
                     Text="{Binding RandomErrorMessage}"
                     IsVisible="{Binding RandomErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </Grid>
    </TabItem>

    <!-- 4) BMI -->
    <TabItem Header="BMI">
      <Grid RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="12" VerticalAlignment="Center" Text="Height (m or cm)"/>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="12" Watermark="e.g., 1.70 or 170"
                 Text="{Binding BmiHeight}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="12" VerticalAlignment="Center" Text="Weight (kg)"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="12"
                 Text="{Binding BmiWeight}"/>

        <Button Grid.Row="2" Grid.Column="1" Margin="12" Padding="12,6" HorizontalAlignment="Left"
                Command="{Binding CalculateBmiCommand}">Calculate BMI</Button>

        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="12">
          <TextBlock FontSize="16" TextWrapping="Wrap" Text="{Binding BmiResult}"/>
          <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="Red"
                     Text="{Binding BmiErrorMessage}"
                     IsVisible="{Binding BmiErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </Grid>
    </TabItem>

    <!-- 5) Data Size -->
    <TabItem Header="Data Size">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" ColumnDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="12" VerticalAlignment="Center" Text="Value"/>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="12" Watermark="e.g., 1536"
                 Text="{Binding DataValue}"/>

        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="12" Spacing="12">
          <TextBlock VerticalAlignment="Center" Text="From"/>
          <ComboBox Width="120"
                    ItemsSource="{Binding DataSizeUnits}"
                    SelectedItem="{Binding SelectedDataFromUnit}"/>
          <TextBlock VerticalAlignment="Center" Text="To"/>
          <ComboBox Width="120"
                    ItemsSource="{Binding DataSizeUnits}"
                    SelectedItem="{Binding SelectedDataToUnit}"/>
        </StackPanel>

        <Button Grid.Row="2" Grid.Column="1" Margin="12" Padding="12,6" HorizontalAlignment="Left"
                Command="{Binding ConvertDataSizeCommand}">Convert</Button>

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="12">
          <TextBlock FontSize="16" TextWrapping="Wrap" Text="{Binding DataResult}"/>
          <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="Red"
                     Text="{Binding DataErrorMessage}"
                     IsVisible="{Binding DataErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </Grid>
    </TabItem>
  </TabControl>
</Window>
